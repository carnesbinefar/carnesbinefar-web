---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Trabaja con nosotros"
  description="¿Buscas trabajo en el sector ganadero? Carnes Binéfar busca personas motivadas para trabajar en sus granjas en la provincia de Huesca."
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Trabaja con nosotros</span>
      </nav>
      <h1>Trabaja con nosotros</h1>
      <p class="lead">Forma parte de un equipo comprometido con el bienestar animal y la excelencia ganadera.</p>
    </div>
  </div>

  <section class="section">
    <div class="container content-grid">
      <div class="form-area">
        <div class="intro-block">
          <p>
            Si estás buscando trabajo dentro del sector ganadero y estarías interesado en mudarte cerca de una de nuestras granjas en la provincia de Huesca, queremos conocerte.
          </p>
          <p>
            No importa si tienes experiencia previa o no. Lo que buscamos son personas con <strong>motivación para trabajar</strong> y ganas de aprender en un entorno profesional y de calidad.
          </p>
        </div>

        <div class="form-success" id="formSuccess" role="alert">
          Tu candidatura ha sido enviada correctamente. Nos pondremos en contacto contigo en breve.
        </div>

        <form
          class="apply-form"
          id="applyForm"
          method="POST"
          action="https://formspree.io/f/YOUR_FORM_ID"
          enctype="multipart/form-data"
          novalidate
        >
          <!-- Reemplaza YOUR_FORM_ID con tu ID de Formspree, o usa el atributo "netlify" si despliegas en Netlify -->
          <input type="hidden" name="_subject" value="Nueva candidatura — Trabaja con nosotros" />

          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre <span class="required" aria-hidden="true">*</span></label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Tu nombre completo" />
            </div>
            <div class="form-group">
              <label for="email">Correo electrónico <span class="required" aria-hidden="true">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="tu@email.com" />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="granja">Granja de preferencia <span class="required" aria-hidden="true">*</span></label>
              <div class="select-wrapper">
                <select id="granja" name="granja" required>
                  <option value="" disabled selected>Selecciona una granja</option>
                  <option value="Espartal">Espartal</option>
                  <option value="Lecineras">Lecineras</option>
                  <option value="Santalecina">Santalecina</option>
                  <option value="Otras">Otras</option>
                </select>
                <svg class="select-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
            <div class="form-group">
              <label for="ciudad">Ciudad de residencia actual</label>
              <input type="text" id="ciudad" name="ciudad" autocomplete="address-level2" placeholder="Tu ciudad actual" />
            </div>
          </div>

          <div class="form-group">
            <label for="comentarios">Comentarios</label>
            <textarea id="comentarios" name="comentarios" placeholder="Cuéntanos algo sobre ti, tu experiencia o cualquier otra información relevante…"></textarea>
          </div>

          <div class="form-group">
            <label for="cv">Curriculum vitae (PDF, DOC — máx. 5MB)</label>
            <input type="file" id="cv" name="cv" accept=".pdf,.doc,.docx" />
            <p class="form-notice">Formatos aceptados: PDF, DOC, DOCX. Tamaño máximo: 5MB.</p>
          </div>

          <div class="form-group form-group-check">
            <label class="checkbox-label">
              <input type="checkbox" name="privacidad" required />
              <span>
                He leído y acepto la <a href="/politica-de-privacidad" target="_blank">política de privacidad</a> de Carnes Binéfar S.A.
              </span>
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-submit">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h12M9 4l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Enviar candidatura
            </button>
            <p class="form-notice">
              Los campos marcados con <span style="color:var(--color-primary)">*</span> son obligatorios. Tus datos se tratarán conforme a nuestra <a href="/politica-de-privacidad">política de privacidad</a>.
            </p>
          </div>
        </form>
      </div>

      <aside class="sidebar">
        <div class="info-card">
          <h3>Nuestras granjas</h3>
          <ul class="farm-list">
            <li>
              <div class="farm-dot" style="background: var(--color-primary)"></div>
              <div>
                <strong>Espartal</strong>
                <span>Comarca de La Litera, Huesca</span>
              </div>
            </li>
            <li>
              <div class="farm-dot" style="background: var(--color-accent)"></div>
              <div>
                <strong>Lecineras</strong>
                <span>Provincia de Huesca</span>
              </div>
            </li>
            <li>
              <div class="farm-dot" style="background: #c07830"></div>
              <div>
                <strong>Santalecina</strong>
                <span>Provincia de Huesca</span>
              </div>
            </li>
          </ul>
        </div>

        <div class="perks-card">
          <h3>¿Por qué unirte?</h3>
          <ul class="perks-list">
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Empresa consolidada con más de 35 años de experiencia
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Formación continua en el sector ganadero
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Reconocida en los Premios Porc d'Or
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Equipo comprometido y profesional
            </li>
            <li>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Se valorará la motivación por encima de la experiencia
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<style>
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 4rem;
    align-items: start;
  }

  .intro-block {
    background: rgba(182, 52, 123, 0.04);
    border-left: 3px solid var(--color-primary);
    padding: 1.25rem 1.5rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin-bottom: 2rem;
  }

  .intro-block p {
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    line-height: 1.7;
  }

  .intro-block p:last-child { margin-bottom: 0; }

  .intro-block strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .required {
    color: var(--color-primary);
    margin-left: 2px;
  }

  .select-wrapper {
    position: relative;
  }

  .select-wrapper select {
    padding-right: 2.5rem;
    cursor: pointer;
  }

  .select-arrow {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--color-text-muted);
  }

  .form-group-check label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    cursor: pointer;
  }

  .checkbox-label input[type="checkbox"] {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    accent-color: var(--color-primary);
    margin-top: 3px;
    cursor: pointer;
  }

  .checkbox-label span {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .checkbox-label a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-start;
    margin-top: 0.5rem;
  }

  .btn-submit {
    min-width: 220px;
    justify-content: center;
  }

  /* Sidebar */
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    position: sticky;
    top: 90px;
  }

  .info-card,
  .perks-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .info-card h3,
  .perks-card h3 {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1.1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--color-primary);
    display: inline-block;
  }

  .farm-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .farm-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .farm-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .farm-list strong {
    display: block;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.1rem;
  }

  .farm-list span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .perks-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .perks-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  .perks-list svg {
    flex-shrink: 0;
    color: var(--color-accent);
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .sidebar {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('applyForm') as HTMLFormElement | null;
  const successMsg = document.getElementById('formSuccess');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.style.display = 'none';
        if (successMsg) successMsg.style.display = 'block';
      } else {
        alert('Ha ocurrido un error. Por favor, inténtalo de nuevo o envíanos un email directamente.');
      }
    } catch {
      alert('Ha ocurrido un error de red. Por favor, inténtalo de nuevo.');
    }
  });
</script>

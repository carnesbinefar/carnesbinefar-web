---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto"
  description="Contacta con Carnes Binéfar S.A. — Calle Azanuy 7, Binéfar, Huesca. Email: info@carnesbinefar.es"
>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Ruta de navegación">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Contacto</span>
      </nav>
      <h1>Contacto</h1>
      <p class="lead">Estamos en Binéfar, Huesca. Escríbenos o llámanos.</p>
    </div>
  </div>

  <section class="section">
    <div class="container contact-grid">
      <!-- Contact info -->
      <div class="contact-info">
        <h2>Información de contacto</h2>
        <div class="contact-items">
          <div class="contact-item">
            <div class="contact-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 2C6.69 2 4 4.69 4 8c0 5 6 10 6 10s6-5 6-10c0-3.31-2.69-6-6-6zm0 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4z" fill="currentColor"/>
              </svg>
            </div>
            <div>
              <strong>Dirección</strong>
              <p>Calle Azanuy 7<br />Binéfar, Huesca (España)</p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M3.5 3h2.8L7.6 7 5.9 8.7a12 12 0 0 0 5.4 5.4L13 12.4l4 1.3v2.8c0 .8-.6 1.5-1.4 1.5C7.4 18 2 12.6 2 4.4 2 3.6 2.7 3 3.5 3z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/>
              </svg>
            </div>
            <div>
              <strong>Teléfono</strong>
              <p><a href="tel:+34974429591">974 42 95 91</a></p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.4"/>
                <path d="M2 7l8 5 8-5" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </div>
            <div>
              <strong>Email</strong>
              <p><a href="mailto:info@carnesbinefar.es">info@carnesbinefar.es</a></p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="2" y="3" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.4"/>
                <path d="M6 3v2M14 3v2M2 9h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <strong>CIF</strong>
              <p>A25206327</p>
            </div>
          </div>
        </div>

        <div class="map-placeholder" aria-label="Ubicación en mapa — Calle Azanuy 7, Binéfar, Huesca">
          <div class="map-inner">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
              <path d="M24 6C16.27 6 10 12.27 10 20c0 12.5 14 26 14 26s14-13.5 14-26c0-7.73-6.27-14-14-14zm0 19a5 5 0 1 1 0-10 5 5 0 0 1 0 10z" fill="var(--color-primary)" opacity="0.3"/>
              <path d="M24 8C17.37 8 12 13.37 12 20c0 11.5 12 24 12 24s12-12.5 12-24c0-6.63-5.37-12-12-12z" stroke="var(--color-primary)" stroke-width="1.5" fill="none"/>
              <circle cx="24" cy="20" r="4" stroke="var(--color-primary)" stroke-width="1.5" fill="none"/>
            </svg>
            <p>Calle Azanuy 7, Binéfar, Huesca</p>
            <a
              href="https://maps.google.com/?q=Calle+Azanuy+7,+Binefar,+Huesca"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline"
              style="margin-top: 0.75rem; font-size: 0.8rem;"
            >
              Ver en Google Maps
            </a>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="form-area">
        <h2>Envíanos un mensaje</h2>

        <div class="form-success" id="formSuccess" role="alert">
          Tu mensaje ha sido enviado correctamente. Nos pondremos en contacto contigo en breve.
        </div>

        <form
          id="contactForm"
          method="POST"
          action="https://formspree.io/f/YOUR_FORM_ID"
          novalidate
        >
          <!-- Reemplaza YOUR_FORM_ID con tu ID de Formspree, o usa el atributo "netlify" si despliegas en Netlify -->
          <input type="hidden" name="_subject" value="Nuevo mensaje de contacto — carnesbinefar.es" />

          <div class="form-row">
            <div class="form-group">
              <label for="nombre">Nombre <span style="color:var(--color-primary)">*</span></label>
              <input type="text" id="nombre" name="nombre" required autocomplete="name" placeholder="Tu nombre" />
            </div>
            <div class="form-group">
              <label for="email">Correo electrónico <span style="color:var(--color-primary)">*</span></label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="tu@email.com" />
            </div>
          </div>

          <div class="form-group">
            <label for="asunto">Asunto</label>
            <input type="text" id="asunto" name="asunto" placeholder="Motivo de tu consulta" />
          </div>

          <div class="form-group">
            <label for="mensaje">Mensaje <span style="color:var(--color-primary)">*</span></label>
            <textarea id="mensaje" name="mensaje" required placeholder="Escribe tu mensaje aquí…"></textarea>
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" name="privacidad" required />
              <span>
                He leído y acepto la <a href="/politica-de-privacidad" target="_blank">política de privacidad</a>
              </span>
            </label>
          </div>

          <button type="submit" class="btn btn-primary btn-submit">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 8h12M9 4l5 4-5 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Enviar mensaje
          </button>

          <p class="form-notice" style="margin-top: 0.75rem;">
            Los campos con <span style="color:var(--color-primary)">*</span> son obligatorios. Datos tratados según la <a href="/politica-de-privacidad">política de privacidad</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-info h2,
  .form-area h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border);
  }

  .contact-items {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-icon {
    width: 42px;
    height: 42px;
    background: rgba(182, 52, 123, 0.08);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .contact-item strong {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.2rem;
  }

  .contact-item p {
    font-size: 0.95rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .contact-item a {
    color: var(--color-primary);
    font-weight: 600;
  }

  .map-placeholder {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .map-inner {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
  }

  .map-inner p {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  /* Form */
  .btn-submit {
    width: 100%;
    justify-content: center;
    gap: 0.5rem;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    cursor: pointer;
  }

  .checkbox-label input {
    width: 18px !important;
    height: 18px !important;
    flex-shrink: 0;
    accent-color: var(--color-primary);
    margin-top: 2px;
    cursor: pointer;
  }

  .checkbox-label span {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .checkbox-label a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const successMsg = document.getElementById('formSuccess');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.style.display = 'none';
        if (successMsg) successMsg.style.display = 'block';
      } else {
        alert('Ha ocurrido un error. Por favor, inténtalo de nuevo o llámanos directamente.');
      }
    } catch {
      alert('Ha ocurrido un error de red. Por favor, inténtalo de nuevo.');
    }
  });
</script>
